diff --git a/bsd/dev/sweet_wdt.c b/bsd/dev/sweet_wdt.c
new file mode 100644
index 0000000..225749a
--- /dev/null
+++ b/bsd/dev/sweet_wdt.c
@@ -0,0 +1,150 @@
+/*
+ * SWEET RK3588 watchdog keeper.
+ *
+ * The RK3588 has a DesignWare watchdog at 0xfeaf0000 whose counter runs from
+ * 2^(16+TORR) pclk cycles. Measured on this board (toolchain/wdt-ccvr.py,
+ * pitfalls.md 91):
+ *
+ *   pclk = 24 MHz, TORR = 0xf -> 2^31 / 24 MHz = 89.5 s to reset
+ *
+ * and, more importantly, it cannot be turned off from the CPU: writing
+ * CR = 0 does not stop the counter, only CRR = 0x76 restarts it. Verified by
+ * reading CCVR before and after the write -- it keeps decreasing. Whatever
+ * arms it (the bootloader, or the PMU) leaves it armed, so the kernel has to
+ * keep kicking it or the board resets 89 s into a perfectly healthy boot.
+ *
+ * So this driver does the only thing that works: a kernel thread writes CRR
+ * every 5 s. It is deliberately dumb -- no IOKit service, no user client --
+ * because IOWatchdog (iokit/Kernel/arm/SweetWatchdog.cpp) is the *userspace*
+ * contract with watchdogd, not a hardware driver.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+
+#define SWEET_WDT_PA      0xfeaf0000UL
+#define SWEET_WDT_CR      0x00
+#define SWEET_WDT_TORR    0x04
+#define SWEET_WDT_CRR     0x0c
+#define SWEET_WDT_CRR_RESTART 0x76
+
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer (same as
+ * sweet_emmc.c and sweet_keys.c). */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+static volatile uint32_t *wdt_regs;
+static uint64_t wdt_period_ms = 5000;
+static uint32_t wdt_limit_s;            /* 0 = 一直喂 */
+static lck_grp_t *wdt_grp;
+static lck_mtx_t *wdt_lock;
+static void *wdt_chan;
+
+static inline uint32_t
+wdt_rd(unsigned off)
+{
+	return wdt_regs[off / 4];
+}
+
+static inline void
+wdt_wr(unsigned off, uint32_t v)
+{
+	wdt_regs[off / 4] = v;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+wdt_sleep(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline((uint32_t)wdt_period_ms, NSEC_PER_MSEC, &deadline);
+	lck_mtx_lock(wdt_lock);
+	(void)assert_wait_deadline(wdt_chan, THREAD_UNINT, deadline);
+	lck_mtx_unlock(wdt_lock);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+wdt_thread(void *arg, wait_result_t result)
+{
+	uint32_t kicks = 0;
+	uint64_t expiry = 0;
+	(void)arg;
+	(void)result;
+	if (wdt_limit_s) {
+		clock_interval_to_deadline(wdt_limit_s, NSEC_PER_SEC, &expiry);
+	}
+	for (;;) {
+		if (expiry && mach_absolute_time() >= expiry) {
+			printf("SWEET WDT: stopped feeding after %u s (sweetwdtafter)\n",
+			    wdt_limit_s);
+			for (;;) {
+				wdt_sleep();
+			}
+		}
+		wdt_wr(SWEET_WDT_CRR, SWEET_WDT_CRR_RESTART);
+		if ((++kicks % 60u) == 0) {
+			/* Every 5 minutes: prove it is still alive and show the counter. */
+			printf("SWEET WDT: kicked %u times, ccvr=%#x cr=%#x\n",
+			    kicks, wdt_rd(0x08), wdt_rd(SWEET_WDT_CR));
+		}
+		wdt_sleep();
+	}
+}
+
+void
+sweet_wdt_start(void)
+{
+	int enabled = 1;
+	thread_t thread;
+
+	if (wdt_regs != NULL) {
+		return;
+	}
+	(void)PE_parse_boot_argn("sweetwdt", &enabled, sizeof(enabled));
+	/*
+	 * sweetwdtafter=N: 只喂 N 秒，然后松手让看门狗复位板子。
+	 *
+	 * 用途：板子跑我们的内核时，U-Boot 的 fastboot 是死的（USB 描述符还在，
+	 * 但 `fastboot reboot` 永远等不到设备），只能靠看门狗把板子拉回来。
+	 * 调试时用 `sweetwdtafter=30` 做一次"30 秒后自动复位"的启动。
+	 */
+	(void)PE_parse_boot_argn("sweetwdtafter", &wdt_limit_s, sizeof(wdt_limit_s));
+	if (!enabled) {
+		printf("SWEET WDT: keeper disabled (sweetwdt=0)\n");
+		return;
+	}
+	wdt_regs = (volatile uint32_t *)ml_io_map(SWEET_WDT_PA, 0x100);
+	if (wdt_regs == NULL) {
+		printf("SWEET WDT: cannot map %#lx\n", (unsigned long)SWEET_WDT_PA);
+		return;
+	}
+	/*
+	 * Longest timeout the block offers, so a busy system still has plenty of
+	 * margin between kicks. TORR is only honoured on the CRR reload, which is
+	 * the first thing the thread does.
+	 */
+	wdt_wr(SWEET_WDT_TORR, 0x0f);
+	wdt_wr(SWEET_WDT_CRR, SWEET_WDT_CRR_RESTART);
+	printf("SWEET WDT: keeper on %#lx, cr=%#x torr=%#x ccvr=%#x (pclk 24 MHz, ~%u s)\n",
+	    (unsigned long)SWEET_WDT_PA, wdt_rd(SWEET_WDT_CR), wdt_rd(SWEET_WDT_TORR),
+	    wdt_rd(0x08), (unsigned)((1ULL << (16 + 15)) / 24000000ULL));
+
+	wdt_grp = lck_grp_alloc_init("sweet-wdt", LCK_GRP_ATTR_NULL);
+	wdt_lock = lck_mtx_alloc_init(wdt_grp, LCK_ATTR_NULL);
+	wdt_chan = (void *)&wdt_regs;
+	if (kernel_thread_start(wdt_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET WDT: kernel_thread_start failed\n");
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
