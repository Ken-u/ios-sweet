+	if (early_mode_done) {
+		return;
+	}
+	early_mode_done = 1;
+	__asm__ volatile("mrs %0, MIDR_EL1" : "=r"(midr));
+	if ((uint32_t)(midr >> 24) == 0x41u) {
+		early_uart = (volatile uint32_t *)(uintptr_t)0xfeb50000;
+	}
+}
+
+/* True when this platform writes to the UART instead of the splash buffer. */
+int
+sweet_early_uses_uart(void)
+{
+	sweet_early_mode();
+	return early_uart != NULL;
+}
