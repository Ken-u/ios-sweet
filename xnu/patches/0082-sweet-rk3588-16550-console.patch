+ * 0x51. That keeps the same kernel binary harmless on the Redmi Note 10 Pro,
+ * where 0xfeb50000 is not a UART.
+ */
+static volatile uint32_t *early_uart;
+static int early_mode_done;
+
+static void
+sweet_early_mode(void)
+{
+	uint64_t midr;
