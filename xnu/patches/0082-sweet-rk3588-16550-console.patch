+#if defined(SWEET)
+/*
+ * RK3588 bring-up markers.
+ *
+ * The board hands over no framebuffer, so sweet_early_mark() (which paints the
+ * Redmi Note 10 Pro's splash buffer at 0x9c000000) is invisible here -- that
+ * address is plain DRAM on RK3588. A polled write to the debug UART works at
+ * every point in this file, with the MMU on or off, because 0xfeb50000 is
+ * mapped identity (bootstrap tables) and the shim has already programmed it
+ * for 1500000 8N1.
+ *
+ * Format: one character per marker, so the position in the boot sequence is
+ * readable straight off the serial line.
+ */
+.macro SWEET_UART_MARK ch
+	/*
+	 * Runtime gate on the CPU implementer: ARM Ltd reports 0x41, Qualcomm's
+	 * custom Kryo cores report 0x51. The same SWEET kernel binary boots both
+	 * the Redmi Note 10 Pro and this board, and 0xfeb50000 is not a UART on
+	 * SM7150 -- writing there could disturb an unrelated block on the one
+	 * working installation. Checking MIDR_EL1 costs a few cycles and makes
+	 * the marker a no-op on the phone.
+	 */
+	mrs		x13, MIDR_EL1
+	lsr		x13, x13, #24
+	cmp		x13, #0x41
+	b.ne	9997f
+	MOV64	x13, 0xfeb50000
+	mov	w14, #\ch
+	str		w14, [x13]
+	dsb		sy
+9997:
+.endmacro
+#else
+.macro SWEET_UART_MARK ch
+.endmacro
+#endif
+
 /*
  * __start trampoline is located at a position relative to LowResetVectorBase
  * so that iBoot can compute the reset vector position to set IORVBAR using
@@ -514,6 +552,20 @@
 	mov		x21, #0
 
 #if defined(SWEET)
+	/*
+	 * RK3588 stage 0: one character on the 16550 debug UART.
+	 *
+	 * The band below writes to the Redmi Note 10 Pro's splash framebuffer at
+	 * 0x9c000000, which on an RK3588 is ordinary DRAM: harmless but silent.
+	 * Without this marker a boot that dies anywhere before serial_init() is
+	 * indistinguishable from one that never entered the kernel at all.
+	 *
+	 * MMU and caches are off and no stack exists, so this is a bare polled
+	 * store to the physical UART. 0xfeb50000 is RK3588's debug UART; the shim
+	 * has already programmed it for 1500000 8N1, so only THR is written.
+	 */
+	SWEET_UART_MARK 'K'
+
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
 	MOV64	x0, (0x9c000000 + 2368 * 4320)
 	mov		w1, #-1
@@ -693,8 +745,30 @@
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+
+	/*
+	 * RK3588 debug UART: map 0xfe000000..0xffffffff as Device, in the same
+	 * V=P L2 table and with the same V=P identity, so pe_kprintf and the
+	 * early markers can reach it once the MMU is on. Without this the only
+	 * console the board has is unreachable for all of arm_init(), which is
+	 * exactly the window where a bring-up failure is currently silent.
+	 *
+	 * One 32MB L2 block covers 0xfe000000..0xffffffff exactly, which holds
+	 * the UART, the GIC and the CRU. Device-nGnRnE (attrindx 0). This is the
+	 * same L2 table the V=P RAM mapping lives in (L1 index 0 for the whole
+	 * 64GB), so no extra table is needed.
+	 */
+	MOV64	x10, 0xfe000000
